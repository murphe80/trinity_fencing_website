# Copy this file to .env.local and fill in your values.
# Never commit .env.local to Git.
# All variables must also be added to Vercel → Project → Settings → Environment Variables.

# Google OAuth credentials JSON (from Google Cloud Console → APIs & Services → Credentials)
# For setup instructions see /docs/GOOGLE_API_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# The ID of the DUFC Google Spreadsheet
# Found in the Sheet URL: docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEETS_ID=

# The dufencing@gmail.com Google Calendar ID (usually the Gmail address itself)
GOOGLE_CALENDAR_ID=dufencing@gmail.com

# Google Drive folder IDs (get from the folder URL in Drive)
DRIVE_GALLERY_FOLDER_ID=
DRIVE_INSTAGRAM_FOLDER_ID=

# Vercel Deploy Hook URL — paste this into the Google Apps Script, not used by the app itself
# Get from: Vercel Dashboard → Project → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/YOUR_HOOK_ID

# Club policies and tournaments (set these on the Render website service)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_POLICIES_FOLDER_ID=1AaHpNCpuR9ePUMC2wJQ3PtIh6bGzMilf
# Verified club results folder.
DRIVE_POULE_RESULTS_FOLDER_ID=1G1nFs7hbro19OUU2RZbDSlRv_x9gq7i8
DRIVE_TOURNAMENT_PHOTOS_FOLDER_ID=1zo58jI0Rsb4CpHRoecsbBeEERoaBIIgJ
# OAuth web-client JSON for Google sign-in and personal My Drive uploads.
# Render: set GOOGLE_OAUTH_CLIENT_JSON to the complete downloaded JSON.
GOOGLE_OAUTH_CLIENT_JSON=
# Local alternative: absolute path to the downloaded OAuth JSON (outside repo).
GOOGLE_OAUTH_CLIENT_FILE=
# Alternatively use GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above plus this URL.
GOOGLE_OAUTH_REDIRECT_URI=https://www.trinityfencing.ie/api/auth/google/callback
# Optional: only needed if running the cache-warming cron job.
CRON_SECRET=
# Used by the separate Render cron job, alongside the same CRON_SECRET.
SITE_URL=https://www.trinityfencing.ie

# Optional local path to a service-account key (never commit the key itself).
GOOGLE_APPLICATION_CREDENTIALS=

DRIVE_POULE_PDF_FOLDER_ID=1jUq8aNtnFqPnrrgABF2lBU1EmVXQUpln

# Google Picker (same Google Cloud project as the OAuth client).
# Enable the Google Picker API. This is a browser API key, not an OAuth secret.
# Restrict the key to Google Picker API and your website referrers plus https://docs.google.com/*.
GOOGLE_PICKER_API_KEY=
# Numeric project number from Google Cloud project settings (not project name/ID).
GOOGLE_CLOUD_PROJECT_NUMBER=
